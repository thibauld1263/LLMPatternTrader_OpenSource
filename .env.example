# Copy this file to ".env" and fill in your own values.

# Full path to your MetaTrader 5 terminal executable.
# (The variable is named MT4_* for legacy reasons but it IS your MT5 path.)
# Tip: use forward slashes to avoid backslash-escape issues, e.g.:
#   MT4_DATA_PATH="C:/Program Files/MetaTrader 5/terminal64.exe"
MT4_DATA_PATH="C:/Program Files/MetaTrader 5/terminal64.exe"

# LLM API keys — only fill in the one(s) for the model you use.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
XAI_API_KEY=""
